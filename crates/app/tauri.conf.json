{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreditBar",
  "version": "0.1.0",
  "identifier": "dev.gustmrg.creditbar",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "CreditBar",
        "width": 340,
        "height": 640,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "API credit balances for your LLM providers, in the tray",
    "longDescription": "Shows the API balance of your DeepSeek, Kimi and OpenRouter accounts in the system tray, plus DeepSeek’s peak / off-peak pricing schedule.",
    "copyright": "© 2026 Zhao Xin, Gustavo Miranda. MIT License.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
