{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Status",
  "version": "0.1.0",
  "identifier": "dev.gustmrg.deepseekstatus",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "DeepSeek Status",
        "width": 340,
        "height": 640,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
